# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Project Settings → API). The publishable/anon key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-anon-or-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Direct Postgres connection used by server-side repositories.
# With hosted Supabase use the transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# "disable" only for local development.
DATABASE_SSL=disable

# Server-only. Needed for account deletion (Supabase admin API). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Optional integrations (server-only).
# Open Food Facts requires an identifying User-Agent: "AppName/Version (contact email)".
OPEN_FOOD_FACTS_USER_AGENT=
# Salling Group back-end API key (developer.sallinggroup.dev, free): food-waste offers near you.
SALLING_API_KEY=
# The ShelfAtlas key (SHELFATLAS_API_KEY) is only used by the GitHub Actions sync job; set it as a
# repository secret, not here.
# AI assistance is optional; the app works fully without it.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
